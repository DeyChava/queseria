# Copia este archivo como ".env" dentro de la carpeta frontend y ajusta los valores.
# Solo las variables que empiezan con VITE_ llegan al navegador: aquí NUNCA van claves secretas.

# Dirección del backend (con /api al final)
VITE_API_URL=http://localhost:5000/api

# Nombre de tu nube de Cloudinary (es público: aparece en las direcciones de las fotos).
# El backend guarda solo el "nombre corto" de cada foto; con este dato el frontend arma su dirección.
VITE_CLOUDINARY_CLOUD_NAME=
